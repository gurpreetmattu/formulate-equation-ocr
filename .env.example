# Copy to .env for local overrides. Never commit the real .env file.

# --- Model artifacts ---
MODEL_PATH=models/full_checkpoint.pt
VOCAB_PATH=models/vocab.json

# --- Device: "auto" (default), "cpu", or "cuda" ---
DEVICE=auto

# --- Flask ---
SECRET_KEY=change-me-in-production
DEBUG=false
HOST=0.0.0.0
PORT=8080

# --- Uploads ---
MAX_UPLOAD_MB=8

# --- Rate limiting (Flask-Limiter string syntax, e.g. "10 per minute") ---
RATE_LIMIT_PREDICT=10 per minute

# --- Examples gallery ---
EXAMPLES_DIR=examples
